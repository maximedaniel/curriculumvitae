@inproceedings{sahoo_tablehop_2016,
	address = {San Jose California USA},
	title = {{TableHop}: {An} {Actuated} {Fabric} {Display} {Using} {Transparent} {Electrodes}},
	isbn = {978-1-4503-3362-7},
	shorttitle = {{TableHop}},
	url = {https://dl.acm.org/doi/10.1145/2858036.2858544},
	doi = {10.1145/2858036.2858544},
	abstract = {We present TableHop, a tabletop display that provides controlled self-actuated deformation and vibro-tactile feedback to an elastic fabric surface while retaining the ability for highresolution visual projection. The surface is made of a highly stretchable pure spandex fabric that is electrostatically actuated using electrodes mounted on its top or underside. It uses transparent indium tin oxide electrodes and high-voltage modulation to create controlled surface deformations. Our setup actuates pixels and creates deformations in the fabric up to ±5 mm. Since the electrodes are transparent, the fabric surface functions as a diffuser for rear-projected visual images, and avoid occlusion by users or actuators. Users can touch and interact with the fabric to experience expressive interactions as with any fabric based shape-changing interface. By using frequency modulation in the high-voltage circuit, it can also create localized tactile sensations on the user’s ﬁngertip when touching the surface. We provide simulation and experimental results for the shape of the deformation and frequency of the vibration of the surface. These results can be used to build prototypes of different sizes and form-factors. We present a working prototype of TableHop that has 30×40 cm2 surface area and uses a grid of 3×3 transparent electrodes. It uses a maximum of 9.46 mW and can create tactile vibrations of up to 20 Hz. TableHop can be scaled to make large interactive surfaces and integrated with other objects and devices. TableHop will improve user interaction experience on 2.5D deformable displays.},
	language = {en},
	urldate = {2024-04-02},
	booktitle = {Proceedings of the 2016 {CHI} {Conference} on {Human} {Factors} in {Computing} {Systems}},
	publisher = {ACM},
	author = {Sahoo, Deepak Ranjan and Hornbæk, Kasper and Subramanian, Sriram},
	month = may,
	year = {2016},
	pages = {3767--3780},
	file = {Sahoo et al. - 2016 - TableHop An Actuated Fabric Display Using Transpa.pdf:C\:\\Users\\maxd5\\Zotero\\storage\\NAIG8TKI\\Sahoo et al. - 2016 - TableHop An Actuated Fabric Display Using Transpa.pdf:application/pdf},
}


