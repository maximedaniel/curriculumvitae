	pages = {720--730},
	file = {Aristoff and Stone - 2012 - The aerodynamics of jumping rope.pdf:C\:\\Users\\mdanie05\\Zotero\\storage\\RSJNK2FI\\Aristoff and Stone - 2012 - The aerodynamics of jumping rope.pdf:application/pdf},
}

