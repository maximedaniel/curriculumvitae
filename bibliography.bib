	title = {44.2: {An} {Analysis} of {Image} {Uniformity} of {Three}‐dimensional {Image} {Based} on {Rotating} {LED} {Array} {Volumetric} {Display} {System}},
	volume = {41},
	issn = {0097-966X, 2168-0159},
	shorttitle = {44.2},
	url = {https://sid.onlinelibrary.wiley.com/doi/10.1889/1.3500551},
	doi = {10.1889/1.3500551},
	abstract = {We analyze the luminance uniformity and color uniformity of the color volumetric 3D display system based on a rotating LED screen. We first analyze the luminance and chromatic coordinate distribution for one RGB cube with different horizontal and vertical view angles and also luminance and color display effect for 64 spatial distributing RGB color cubes. To evaluate the luminance uniformity and color uniformity of 3D image with different display positions, we present three indexes for them respectively. For luminance uniformity, the indexes are the average luminance, the normalized luminance difference, and the average normalized luminance difference. And for color uniformity the indexes are the average of color difference, the maximum color difference, and the variance of color difference. By these evaluation parameters, we can compare luminance and color uniformity in different 3D volumetric display systems.},
	language = {en},
	number = {1},
	urldate = {2025-07-28},
